# Kopiraj ovaj fajl u .env i po potrebi izmeni vrednosti.

# Za test sa Wokwi simulatorom (simulator ne vidi lokalni Mosquitto):
# MQTT_URL=mqtt://broker.hivemq.com
# Za pravu ploču na kućnoj mreži ostavi lokalni broker:
MQTT_URL=mqtt://mosquitto:1883

MQTT_TOPIC_ROOT=smart_alarm

POSTGRES_DB=smart_alarm
POSTGRES_USER=alarm
POSTGRES_PASSWORD=alarm
